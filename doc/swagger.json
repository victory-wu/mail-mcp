{
    "swagger": "2.0",
    "info": {
        "description": "Administrative REST endpoints for Redis account configuration. Enable with --backend-api-key or BACKEND_API_KEY. MCP JSON-RPC tools are described by MCP tool discovery, not this REST specification.",
        "title": "Mail MCP Account Management API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/admin/accounts": {
            "get": {
                "security": [
                    {
                        "BackendBearer": []
                    }
                ],
                "description": "Literal, case-sensitive matching against hostname-email-UUID. Returns full account configuration, including credentials. No matches returns an empty array. Responses are not cached.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Accounts"
                ],
                "summary": "Query accounts by subkey prefix",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Subkey prefix: hostname-email",
                        "name": "prefix",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BackendBearer": []
                    }
                ],
                "description": "Stores account configuration under hostname-email-UUID. Hostname identifies the calling machine, independently of IMAP/SMTP hosts. Maximum request body: 64 KiB. MCP tools reload changes on restart.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Accounts"
                ],
                "summary": "Create an account",
                "parameters": [
                    {
                        "description": "Account configuration; hostname, email, imap.host and imap.password are required",
                        "name": "account",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/config.CreateAccountInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountCreatedResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    }
                }
            }
        },
        "/admin/accounts/{subkey}": {
            "delete": {
                "security": [
                    {
                        "BackendBearer": []
                    }
                ],
                "description": "Deletes exactly one Redis hash field without deleting mailbox messages. MCP tools reload changes on restart.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Accounts"
                ],
                "summary": "Delete an account by subkey",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Complete hostname-email-UUID subkey",
                        "name": "subkey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Account deleted"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httpx.accountErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "config.Account": {
            "type": "object",
            "properties": {
                "from_address": {
                    "description": "FromAddress overrides the From header. Defaults to the SMTP username,\nwhich matters for providers where the login differs from the sending\nidentity (iCloud custom domains, Google Workspace aliases).",
                    "type": "string"
                },
                "from_name": {
                    "description": "FromName is the optional display name on outgoing mail.",
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "imap": {
                    "$ref": "#/definitions/config.Endpoint"
                },
                "imap_host": {
                    "description": "---- legacy flat keys (poke-mail v1 config), normalized on load ----",
                    "type": "string"
                },
                "imap_password": {
                    "type": "string"
                },
                "imap_port": {
                    "type": "integer"
                },
                "imap_username": {
                    "type": "string"
                },
                "save_sent": {
                    "description": "SaveSent controls whether outgoing mail is APPENDed to the Sent\nfolder. Nil means \"decide from the provider\" — see ShouldSaveSent.",
                    "type": "boolean"
                },
                "smtp": {
                    "$ref": "#/definitions/config.Endpoint"
                },
                "smtp_host": {
                    "type": "string"
                },
                "smtp_password": {
                    "type": "string"
                },
                "smtp_port": {
                    "type": "integer"
                },
                "smtp_username": {
                    "type": "string"
                }
            }
        },
        "config.AccountRecord": {
            "type": "object",
            "properties": {
                "account": {
                    "$ref": "#/definitions/config.Account"
                },
                "subkey": {
                    "type": "string"
                }
            }
        },
        "config.CreateAccountInput": {
            "type": "object",
            "required": [
                "email",
                "hostname",
                "imap"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "from_address": {
                    "type": "string"
                },
                "from_name": {
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                },
                "imap": {
                    "$ref": "#/definitions/config.Endpoint"
                },
                "save_sent": {
                    "type": "boolean"
                },
                "smtp": {
                    "$ref": "#/definitions/config.Endpoint"
                }
            }
        },
        "config.Endpoint": {
            "type": "object",
            "properties": {
                "host": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "security": {
                    "$ref": "#/definitions/config.Security"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "config.Security": {
            "type": "string",
            "enum": [
                "tls",
                "starttls",
                "plain"
            ],
            "x-enum-varnames": [
                "SecurityTLS",
                "SecuritySTARTTLS",
                "SecurityPlain"
            ]
        },
        "httpx.accountCreatedResponse": {
            "type": "object",
            "properties": {
                "subkey": {
                    "type": "string"
                }
            }
        },
        "httpx.accountErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "httpx.accountsResponse": {
            "type": "object",
            "properties": {
                "accounts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/config.AccountRecord"
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "BackendBearer": {
            "description": "Enter Bearer followed by the management key configured with --backend-api-key or BACKEND_API_KEY.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}